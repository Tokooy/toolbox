# 版本控制与本地环境
.git/
.gitignore
.venv*/
venv/

# 打包产物与日志（不需要进镜像）
build/
dist/
*.log
desktop.ini
Thumbs.db

# Python 缓存
**/__pycache__/
**/*.pyc

# 冒烟测试的临时数据目录
.smoke-*/

# 用户数据不入镜像 —— 运行时用数据卷挂载到 /app/data
# 注意：data/treasury/ 是内置的离线种子数据，必须保留，因此这里只排除 data/qrcode
data/qrcode/

# 打包脚本本身不需要进运行镜像
packaging/

# 旧版目录（若本地仍存在，避免被送进构建上下文）
QRcode/
us-treasury-yields/
